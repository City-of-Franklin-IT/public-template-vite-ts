# MSAL (Microsoft Authentication Library) Configuration
# Required for parent-template: Full authentication with login UI
# Optional for child-template: Silent token acquisition from parent app
# Not needed for public-template: No authentication

# Azure Entra ID Application Client ID
# Register your app in Azure Portal: Entra ID > App registrations
VITE_MSAL_CLIENT_ID=your_client_id_here

# Azure Tenant ID
# Copy from Azure Portal or use 'common' for multi-tenant
VITE_MSAL_TENANT_ID=common

# Redirect URI after login
# Must be registered in your Azure app registration Redirect URIs
# Development example:
# VITE_MSAL_REDIRECT_URI=http://localhost:5173
# Production example:
# VITE_MSAL_REDIRECT_URI=https://yourdomain.com/your-app
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# API Configuration (if your app has a backend API)
# Leave empty if not using an API
# VITE_API_BASE_URL=https://api.example.com

# Additional environment variables for your application
# NODE_ENV is automatically set by Vite build/dev commands
